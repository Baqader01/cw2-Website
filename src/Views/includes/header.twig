<header>
    <figure class="logo">
        <img src="/website/assets/logos/CommunityTable-logo.png" alt="The Community Table logo">
    </figure>

    <div class="title">
        <h1>The Community Table</h1>
        <p class="tagline">A table set for all</p>
        <nav aria-label="Main navigation">
        <ul>
